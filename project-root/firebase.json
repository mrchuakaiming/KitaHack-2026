{
  "functions": [
    {
      "source": "server_side",
      "codebase": "default",
      "runtime": "python311",
      "ignore": [
        "venv",
        ".env/venv",
        ".git",
        "firebase-debug.log",
        "__pycache__",
        "*.pyc",
        ".pytest_cache"
      ]
    }
  ],
  "hosting": {
    "public": "client_side/build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}